            "🚀 *ENVOYER UN SIGNAL À TOUS*\n\n"
            "Envoyez le signal au format :\n"
            "`CIBLE:CONFIANCE:HEURE:MINUTE`\n\n"
            "_Exemple :_ `3.50:92:14:30`",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
            parse_mode="Markdown"
        )

    # ── ADMIN : LISTE UTILISATEURS ────────────────────────────────────────────
    elif query.data == "adm_users":
        if not is_admin(u_id):
            await query.answer("⛔", show_alert=True)
            return
        await query.answer()
        users_list = [(uid, d) for uid, d in db.items() if uid != "_meta"]
        txt = f"👥 *LISTE DES UTILISATEURS* ({len(users_list)})\n\n"
        for uid, d in users_list[:20]:
            txt += f"• `{uid}` — *{d.get('n', '?')}*\n"
        if len(users_list) > 20:
            txt += f"\n_...et {len(users_list) - 20} autres utilisateurs._"
        await query.edit_message_text(
            txt,
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
            parse_mode="Markdown"
        )

# ==========================================
# GESTION DES MESSAGES TEXTE
# ==========================================
async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    u_id = str(update.effective_user.id)
    user_data = get_user(u_id)
    text = update.message.text.strip()
    state = user_data.get("s", "idle")

    # ══════════════════════════════════════════════════════════════════════════
    # ÉTATS ADMIN
    # ══════════════════════════════════════════════════════════════════════════

    # ── ADMIN : DIFFUSION ──────────────────────────────────────────────────────
    if state == "adm_wait_broadcast" and is_admin(u_id):
        user_data["s"] = "idle"
        save_db(db)
        users_list = [uid for uid in db if uid != "_meta"]
        sent, failed = 0, 0
        broadcast_msg = f"📢 *MESSAGE DU GÉRANT*\n\n{text}"
        for uid in users_list:
            if uid == u_id:
                continue
            try:
                await context.bot.send_message(chat_id=uid, text=broadcast_msg, parse_mode="Markdown")
                sent += 1
                await asyncio.sleep(0.05)
            except Exception:
                failed += 1
        await update.message.reply_text(
            f"✅ *Diffusion terminée !*\n\n📤 Envoyé : `{sent}`\n❌ Échoué : `{failed}`",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
            parse_mode="Markdown"
        )

    # ── ADMIN : NEWS (TITRE) ──────────────────────────────────────────────────
    elif state == "adm_wait_news_title" and is_admin(u_id):
        user_data["s"] = "adm_wait_news_body"
        user_data["_tmp_news_title"] = text
        save_db(db)
        await update.message.reply_text(
            f"📰 Titre enregistré : *{text}*\n\nMaintenant envoyez le *contenu* de la news :",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
            parse_mode="Markdown"
        )

    # ── ADMIN : NEWS (CORPS) ──────────────────────────────────────────────────
    elif state == "adm_wait_news_body" and is_admin(u_id):
        title = user_data.pop("_tmp_news_title", "News")
        news_item = {
            "title": title,
            "body": text,
            "date": datetime.now().strftime("%d/%m/%Y %H:%M")
        }
        db["_meta"]["news"].append(news_item)
        user_data["s"] = "idle"
        save_db(db)
        await update.message.reply_text(
            f"✅ *News publiée avec succès !*\n\n📌 *{title}*\n{text}",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
            parse_mode="Markdown"
        )

    # ── ADMIN : ENVOYER SIGNAL À TOUS ────────────────────────────────────────
    elif state == "adm_wait_signal" and is_admin(u_id):
        user_data["s"] = "idle"
        save_db(db)
        try:
            parts = text.split(":")
            sig_coef = float(parts[0])
            sig_conf = parts[1]
            sig_time = f"{parts[2]}:{parts[3]}"
            users_list = [uid for uid in db if uid != "_meta" and uid != u_id]
            sent, failed = 0, 0
            sig_msg = (
                f"🔥 *SIGNAL OFFERT PAR L'ADMIN*\n"
                f"━━━━━━━━━━━━━━━\n"
                f"🎯 Côte : `{sig_coef}x`\n"
                f"⚡ Confiance : `{sig_conf}%`\n"
                f"⏰ Heure : `{sig_time}`\n"
                f"━━━━━━━━━━━━━━━\n"
                f"⚠️ Jouez cette cible sur les *3 rounds* suivant l'heure indiquée."
            )
            for uid in users_list:
                try:
                    await context.bot.send_message(chat_id=uid, text=sig_msg, parse_mode="Markdown")
                    sent += 1
                    await asyncio.sleep(0.05)
                except Exception:
                    failed += 1
            await update.message.reply_text(
                f"✅ *Signal envoyé !*\n\n📤 Reçu par : `{sent}` utilisateurs\n❌ Échoué : `{failed}`",
                reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
                parse_mode="Markdown"
            )
        except Exception:
            await update.message.reply_text(
                "❌ Format invalide. Utilisez : `CIBLE:CONFIANCE:HEURE:MINUTE`\nEx: `3.50:92:14:30`",
                reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Admin", callback_data="admin_panel")]]),
                parse_mode="Markdown"
            )

