async def monitor_rounds(bot):
    global LAST_SEEN_ROUND
    try:
        coefs = await fetch_external_coefs(limit=1, timeout=5.0)
        if coefs:
            latest_coef = coefs[0]
            if LAST_SEEN_ROUND != latest_coef:
                LAST_SEEN_ROUND = latest_coef
                real_coef = latest_coef
                round_ts = time.time()
                current_ts = time.time()
                db_changed = False

                for uid, u_data in db.items():
                    if uid == "_meta":
                        continue
                    active_bet = u_data.get("active_bet")
                    if not active_bet:
                        continue

                    start_ts = active_bet.get("start_ts", 0)
                    valid_from_ts = active_bet.get("valid_from_ts", 0)
                    valid_until_ts = active_bet.get("valid_until_ts")
                    bet_type = active_bet.get("type", "p")

                    if current_ts < start_ts:
                        continue

                    if bet_type == "g":
                        target = active_bet["target"]
                        insurance = active_bet.get("insurance", 0)

                        if round_ts >= valid_from_ts and valid_until_ts and round_ts < valid_until_ts:
                            if real_coef not in active_bet["collected_coefs"]:
                                active_bet["collected_coefs"].append(real_coef)
                            u_data["active_bet"] = active_bet
                            db_changed = True

                        elif valid_until_ts and current_ts >= valid_until_ts:
                            collected = active_bet.get("collected_coefs", [])
                            best_coef = max(collected) if collected else 0.0

                            if best_coef >= target:
                                u_data["win"] += 10
                                msg = (
                                    f"🎉 *GRAND SIGNAL VALIDÉ !*\n\n"
                                    f"✅ Cible `{target}x` atteinte !\n"
                                    f"📈 Meilleure cote de la plage : `{best_coef}x`\n"
                                    f"💰 Bien joué !"
                                )
                            elif best_coef >= insurance:
                                u_data["win"] += 5
                                msg = (
                                    f"🛡 *ASSURANCE ACTIVÉE !*\n\n"
                                    f"La côte principale `{target}x` n'a pas été atteinte.\n"
                                    f"✅ Mais l'assurance `{insurance}x` est validé !\n"
                                    f"📈 Lucky jet a crashé a : `{best_coef}x`\n"
                                    f"💰 Gain partiel sauvegardé."
                                )
                            else:
                                msg = (
                                    f"❌ *GRAND SIGNAL ÉCHOUÉ*\n\n"
                                    f"Ni la côte `{target}x` ni l'assurance `{insurance}x` "
                                    f"n'ont été atteintes sur la plage.\n"
                                    f"📉 Meilleure cote enregistrée : `{best_coef}x`\n"
                                    f"Restez prudent sur le prochain signal. 🔄"
                                )
                            try:
                                sent_msg = await bot.send_message(chat_id=uid, text=msg, parse_mode="Markdown")
                                u_data["last_val_msg"] = sent_msg.message_id
                            except Exception:
                                pass
                            u_data["active_bet"] = None
                            db_changed = True

                    else:
                        if round_ts < valid_from_ts:
                            continue
                        target = active_bet["target"]
                        if real_coef >= target:
                            u_data["win"] += 10
                            msg = (
                                f"🎉 *PRÉDICTION VALIDÉE !*\n\n"
                                f"✅ La côte de `{target}x` a été validé avec succès ! "
                                f"(Craché à `{real_coef}x`).\nBien joué ! 💰"
                            )
                            try:
                                sent_msg = await bot.send_message(chat_id=uid, text=msg, parse_mode="Markdown")
                                u_data["last_val_msg"] = sent_msg.message_id
                            except Exception:
                                pass
                            u_data["active_bet"] = None
                            db_changed = True
                        else:
                            active_bet["rounds"] += 1
                            if active_bet["rounds"] >= 3:
                                msg = (
                                    f"❌ *PRÉDICTION ÉCHOUÉE*\n\n"
                                    f"La côte de `{target}x` n'a pas été atteinte après "
                                    f"3 rounds consécutifs. (Dernier crash: `{real_coef}x`).\n"
                                    f"Restez prudent sur le prochain signal. 🔄"
                                )
                                try:
                                    sent_msg = await bot.send_message(chat_id=uid, text=msg, parse_mode="Markdown")
                                    u_data["last_val_msg"] = sent_msg.message_id
                                except Exception:
                                    pass
                                u_data["active_bet"] = None
                                db_changed = True
                            else:
                                u_data["active_bet"] = active_bet
                                db_changed = True

                if db_changed:
                    save_db(db)
    except Exception:
        pass

async def monitor_loop(bot):
    while True:
        await monitor_rounds(bot)
        await asyncio.sleep(5)

