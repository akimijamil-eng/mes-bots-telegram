def _extract_coef(item):
    if not isinstance(item, dict):
        return None
    c = item.get("coef")
    if c is None:
        c = item.get("crash")
    if c is None:
        c = item.get("value")
    if c is None:
        c = item.get("topCoefficient")
    if c is None:
        c = item.get("multiplier")
    if c is None:
        return None
    try:
        return round(float(c), 2)
    except (TypeError, ValueError):
        return None

async def fetch_external_coefs(limit=20, timeout=10.0):
    """Coefficients récents (le plus récent en premier), directement depuis le fournisseur du jeu."""
    try:
        async with httpx.AsyncClient(timeout=timeout) as client:
            res = await client.get(HISTORY_URL, headers=EXTERNAL_HEADERS)
            if res.status_code != 200:
                return None
            raw = res.json()
    except Exception as e:
        logging.error(f"Exception source externe: {e}")
        return None

    items = raw if isinstance(raw, list) else raw.get("data", [])
    coefs = [c for c in (_extract_coef(i) for i in items[:limit]) if c is not None]
    return coefs

async def get_allpredictor_signal():
    """Reproduit l'ancien algorithme de /predict, calculé localement à partir des coefs réels."""
    coefs = await fetch_external_coefs(limit=20)
    if not coefs:
        return None, "Impossible de récupérer les données du jeu (source externe injoignable)."

    count = len(coefs)
    avg = sum(coefs) / count
    above2 = sum(1 for c in coefs if c >= 2)
    low = sum(1 for c in coefs if c < 1.5)
    recent3 = coefs[:3]
    recent3_avg = sum(recent3) / len(recent3) if recent3 else avg

    confidence_raw = round(
        60
        + (above2 / count) * 25
        - (low / count) * 30
        + (8 if recent3_avg >= 2 else (-12 if recent3_avg < 1.5 else 0))
    )
    confidence = max(55, min(97, confidence_raw))

    weighted_base = (recent3_avg * 2 + avg) / 3
    jitter = (random.random() - 0.5) * 0.6  # ±0.3 max
    raw_pred = max(1.30, weighted_base + jitter)
    predicted_coef = round(min(5.50, raw_pred), 2)

    bet_dt = datetime.now() + timedelta(minutes=random.randint(1, 4))
    bet_time = bet_dt.strftime("%H:%M")

    return {
        "predicted_coef": predicted_coef,
        "confidence": confidence,
        "bet_time": bet_time,
    }, None

